# Data access mode: "sqlite" (default, fully offline/local) or "api"
# (local-first with background sync to a remote backend when online).
VITE_DATA_MODE=sqlite

# Base URL of the backend API. Only used when VITE_DATA_MODE=api.
# Must implement PUT /users and PUT /attendance (idempotent upserts keyed
# by the "id" field of the payload). Leave empty for sqlite mode.
VITE_API_BASE_URL=
